# zettelkasten-mcp configuration
# All variables are prefixed ZETTELKASTEN_ and can also be set via a .env file in the vault root or CWD.

# Path to the markdown vault root (REQUIRED)
ZETTELKASTEN_VAULT_PATH=/path/to/your/vault

# ChromaDB persistence directory
ZETTELKASTEN_CHROMA_PATH=~/.local/share/zettelkasten-rag

# Ollama API endpoint
ZETTELKASTEN_OLLAMA_URL=http://localhost:11434

# Ollama embedding model (must match what was pulled)
ZETTELKASTEN_EMBEDDING_MODEL=nomic-embed-text

# Comma-separated vault-relative directories to index
ZETTELKASTEN_INDEX_DIRS=notes,literature,indexes

# Comma-separated vault-relative directories to skip
ZETTELKASTEN_SKIP_DIRS=journals,Customer,.git
